{
  "name": "berapa-jam-kerja",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cost of living in Indonesia, Southeast Asia, Korea and Japan, measured in minutes of minimum-wage work.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check-data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check-data": "tsx scripts/check-data.ts",
    "check-data:strict": "tsx scripts/check-data.ts --strict",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "og": "tsx scripts/og.ts"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
